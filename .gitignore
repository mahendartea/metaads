# ============================================================
# .gitignore — UUI × Meta presentasi workspace
# ============================================================

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# --- Windows / Linux editor temp ---
Thumbs.db
ehthumbs.db
Desktop.ini
*~

# --- Editors / IDE ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# --- Python (tools/build_pptx.py) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
env/
ENV/
*.pyo

# --- Node (jika ada tooling tambahan) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock

# --- Logs & temp ---
*.log
*.tmp
*.temp
*.bak
*.orig
tmp/
temp/

# --- Generated build artifacts (opsional, hapus komentar jika ingin commit) ---
# tools/c2-01.png
# tools/w2-01.png
# tools/check2.pdf
